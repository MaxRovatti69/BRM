# demo shows synthetic examples; live reads the persistent webhook database.
BOARD_MODE=demo
BRM_TIME_ZONE=Europe/Rome
# Exactly the namespace in the webhook payload, not a guessed account name.
BRM_NAMESPACE=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Receiver-side secret in the URL, NOT a BRM signature. Never commit real values.
WEBHOOK_URL_TOKEN=
# Live board uses browser HTTP Basic auth, independent of BRM.
BOARD_USERNAME=board
BOARD_PASSWORD=
# Production must point to a mounted persistent disk.
DATABASE_PATH=./data/reservations.sqlite
